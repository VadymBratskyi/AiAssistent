# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to talk to the bot.
# Send /start to the bot once, then read your chat_id from the bot logs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Claude auth comes from the local `claude` CLI session (~/.claude/).
# No API key needed — make sure `claude --version` works and you're logged in.

# Optional: override the model Claude Agent SDK uses
# ANTHROPIC_MODEL=claude-opus-4-7

# Path to the SQLite database file (mounted on a PVC in Rancher)
ASSISTANT_DB_PATH=./assistant.sqlite

# Logging level
LOG_LEVEL=INFO

# --- Host-helper (для /reauth і /pull) ---
# Заповнюється після запуску deploy/install-host-helper.ps1
# HOST_HELPER_URL=http://host.docker.internal:47823
# HOST_HELPER_TOKEN=

# --- Auto git-pull ---
# Список імен репо для щоденного pull о 08:00 буднями.
# Мають бути в allowlist на хості (~/.assistant-helper-repos.json).
AUTO_PULL_REPOS=creatio-ui,creatio-core

# --- Team orchestrator API (локальний HTTP для Claude-сесій команд) ---
# Шлях до teams.yaml (шаблон — teams.yaml.example).
# Якщо файла немає, API не підіймається.
TEAMS_CONFIG_PATH=./teams.yaml
# Bearer-токен, яким оркестратор авторизується. Згенеруй: `python -c "import secrets; print(secrets.token_hex(24))"`
# Порожній = без авторизації (тільки для localhost і тільки тимчасово).
ORCHESTRATOR_TOKEN=
# Інтерфейс/порт для API. 127.0.0.1 — найбезпечніше.
ORCHESTRATOR_API_HOST=127.0.0.1
ORCHESTRATOR_API_PORT=47824

# --- Voice (STT via faster-whisper, local, no API key) ---

# Model size: tiny | base | small | medium | large-v3
# `small` is the sweet spot for Ukrainian quality vs. RAM (~500MB).
WHISPER_MODEL_SIZE=small

# Force a language code (e.g. uk, en) to skip auto-detect.
# Leave empty for auto-detect — fine for mixed UK/EN speech.
WHISPER_LANGUAGE=

# Where to cache the downloaded model. In Rancher set this to /data/whisper
# so the ~500MB download persists in the PVC across pod restarts.
WHISPER_CACHE_DIR=
