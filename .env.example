# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to talk to the bot.
# Send /start to the bot once, then read your chat_id from the bot logs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Claude auth comes from the local `claude` CLI session (~/.claude/).
# No API key needed — make sure `claude --version` works and you're logged in.

# Optional: override the model Claude Agent SDK uses
# ANTHROPIC_MODEL=claude-opus-4-7

# Path to the SQLite database file (mounted on a PVC in Rancher)
ASSISTANT_DB_PATH=./assistant.sqlite

# Logging level
LOG_LEVEL=INFO

# --- Voice (STT via faster-whisper, local, no API key) ---

# Model size: tiny | base | small | medium | large-v3
# `small` is the sweet spot for Ukrainian quality vs. RAM (~500MB).
WHISPER_MODEL_SIZE=small

# Force a language code (e.g. uk, en) to skip auto-detect.
# Leave empty for auto-detect — fine for mixed UK/EN speech.
WHISPER_LANGUAGE=

# Where to cache the downloaded model. In Rancher set this to /data/whisper
# so the ~500MB download persists in the PVC across pod restarts.
WHISPER_CACHE_DIR=
