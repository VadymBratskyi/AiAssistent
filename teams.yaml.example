# Опис команд, з якими взаємодіє бот. Кожна команда — це проєкт + те, куди
# слати її нотифікації в Telegram. Ключ словника (sib-team) — це team_id,
# який оркестратор підставляє в URL: /teams/sib-team/notify і т.д.
#
# Шлях до цього файлу задається у .env через TEAMS_CONFIG_PATH
# (дефолт: ./teams.yaml). Файл опційний — якщо його нема, API вимкнений.

teams:
  sib-team:
    project: SIB
    jira_project_key: SIB
    # chat_id куди бот надсилатиме нотифікації команди (твій особистий чат,
    # або груповий, якщо потрібно). Якщо не задано — fallback на першого адміна.
    notify_chat_id: null
    # Довільний опис, показується в /team info
    description: "SIB project team"
